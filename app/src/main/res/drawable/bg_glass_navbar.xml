<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Ambient Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <solid android:color="@color/glass_nav_shadow" />
        </shape>
    </item>

    <!-- Translucent Frosted Glass Dock with 32dp Corner Radius & Neon Edge Glow -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/glass_nav_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_nav_stroke" />
        </shape>
    </item>
</layer-list>
