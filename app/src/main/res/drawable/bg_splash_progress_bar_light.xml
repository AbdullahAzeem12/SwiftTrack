<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Light Mode Background Track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#201A103C" />
            <stroke android:width="1dp" android:color="#301A103C" />
        </shape>
    </item>

    <!-- Progress Filler with Gold to Deep Indigo Gradient -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <gradient
                    android:angle="0"
                    android:endColor="#1A103C"
                    android:centerColor="#E08405"
                    android:startColor="#FF9E1B" />
            </shape>
        </clip>
    </item>
</layer-list>
