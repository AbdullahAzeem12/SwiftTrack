<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#38BDF8">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="@color/surface_card"
                android:startColor="@color/surface_subtle"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_amber" />
            <size
                android:width="44dp"
                android:height="44dp" />
        </shape>
    </item>
</ripple>
