<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking Checkout"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Production Real-Time Fare Quote Guarantee Banner Container -->
            <RelativeLayout
                android:id="@+id/layout_quote_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_badge"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/btn_refresh_fare"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_quote_timer_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Guarantee Timer"
                        app:tint="@color/quote_banner_text"
                        android:src="@drawable/ic_timer" />

                    <TextView
                        android:id="@+id/tv_quote_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        tools:text="Price Quote Guaranteed for 14:59 mins"
                        android:textColor="@color/quote_banner_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh_fare"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="@color/action_btn_blue"
                    android:paddingHorizontal="12dp"
                    android:text="Refresh"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="14dp"
                    app:iconTint="@color/white"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:cornerRadius="10dp" />
            </RelativeLayout>

            <!-- Main Journey & Class Summary Card (Journey Details Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_journey_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JOURNEY DETAILS"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Class Selected Badge -->
                        <TextView
                            android:id="@+id/tv_checkout_class_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_pill_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            tools:text="STANDARD CLASS"
                            android:textColor="@color/primary_indigo"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tv_checkout_route"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="London Paddington ➔ Heathrow Terminal 5"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_checkout_details_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="Today • 15 min non-stop • 1 Adult Standard Class"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/divider_color" />

                    <!-- Price Breakdown Table -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_subtotal_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Base Subtotal"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_checkout_subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            tools:text="£25.00"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/row_promo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tv_checkout_promo_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Online Discount / Promo"
                            android:textColor="@color/status_green" />

                        <TextView
                            android:id="@+id/tv_checkout_discount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            tools:text="-£2.50"
                            android:textColor="@color/status_green"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Dynamic Rewards Points Discount Row -->
                    <RelativeLayout
                        android:id="@+id/row_rewards_discount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_checkout_rewards_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SWIFTTRACK Rewards Discount"
                            android:textColor="@color/status_green" />

                        <TextView
                            android:id="@+id/tv_checkout_rewards_discount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            tools:text="-£1.00"
                            android:textColor="@color/status_green"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/divider_color" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Amount"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            tools:text="£22.50"
                            android:textColor="@color/primary_indigo"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. PROMO CODE EXPANDABLE ACCORDION SECTION -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_checkout_promo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Accordion Header Bar -->
                    <LinearLayout
                        android:id="@+id/layout_header_promo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Promo Code"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_toggle_promo_indicator"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#0EA5E9"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Expandable Body Container -->
                    <LinearLayout
                        android:id="@+id/layout_expandable_promo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider_color" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_promo_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter promo code (e.g. SWIFTTRACK20)"
                            app:boxBackgroundColor="@color/surface_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_checkout_promo_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_apply_checkout_promo"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:backgroundTint="#0EA5E9"
                                android:text="APPLY"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_remove_checkout_promo"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="10dp"
                                android:backgroundTint="@color/status_red"
                                android:text="CLEAR"
                                android:textColor="@color/white"
                                android:visibility="gone"
                                app:cornerRadius="12dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_promo_status_msg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/status_green"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:text="✓ 20% discount applied (SWIFTTRACK20)"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. SWIFTTRACK REWARDS EXPANDABLE ACCORDION SECTION -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_checkout_rewards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Accordion Header Bar -->
                    <LinearLayout
                        android:id="@+id/layout_header_rewards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SWIFTTRACK Rewards"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_toggle_rewards_indicator"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#0EA5E9"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Expandable Body Container -->
                    <LinearLayout
                        android:id="@+id/layout_expandable_rewards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider_color" />

                        <!-- Available Points Summary Header -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_rewards_available_points"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available Points: 250 pts"
                                android:textColor="@color/accent_amber_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="100 pts = £1.00"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </RelativeLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_rewards_points_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Points to use (e.g. 100)"
                            app:boxBackgroundColor="@color/surface_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_rewards_points_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_apply_rewards"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:backgroundTint="#0EA5E9"
                                android:text="APPLY REWARDS"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_remove_rewards"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="10dp"
                                android:backgroundTint="@color/status_red"
                                android:text="CLEAR"
                                android:textColor="@color/white"
                                android:visibility="gone"
                                app:cornerRadius="12dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_rewards_summary_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_pill_badge"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_rewards_points_used_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Points Used: 500 pts"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_amber_dark" />

                            <TextView
                                android:id="@+id/tv_rewards_discount_calc_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reward Discount: -£5.00"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/status_green"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tv_rewards_remaining_points_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remaining Points: 700 pts"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_rewards_status_msg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/status_green"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:text="✓ £1.00 rewards discount applied"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Class Amenities Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_class_features_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INCLUDED WITH YOUR BOOKING"
                        android:textColor="@color/primary_indigo"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_class_features_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="⚡ Power sockets at every seat • 📶 Free High-Speed Wi-Fi • 🧳 Spacious luggage racks • 🛡️ 100% Refund protection"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Email Contact Box -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_contact_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Ticket Email Delivery Address"
                app:boxBackgroundColor="@color/surface_card"
                app:errorEnabled="true"
                app:startIconDrawable="@android:drawable/ic_dialog_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_contact_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Terms Checkbox -->
            <CheckBox
                android:id="@+id/cb_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="I accept the fare conditions and train travel terms"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_proceed_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/primary_indigo"
                android:text="Proceed to Secure Payment 🔒"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
