# SwiftTrack Environment Template (No Secrets Committed)

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/swifttrack
SPRING_DATASOURCE_USERNAME=swifttrack_user
SPRING_DATASOURCE_PASSWORD=swifttrack_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Security Tokens
JWT_SECRET=YOUR_SUPER_SECRET_64_CHAR_HEX_KEY_HERE
PAYMENT_WEBHOOK_SECRET=YOUR_SANDBOX_WEBHOOK_SECRET_HERE

# FCM / Firebase
FIREBASE_CONFIG_PATH=config/firebase-service-account.json

# Mail Server
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=test
MAIL_PASSWORD=test
