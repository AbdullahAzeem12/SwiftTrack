# SwiftTrack Backend Environment Configuration
# National Rail RDM (Rail Data Marketplace) Darwin Push Consumer Config

# Darwin Push Kafka Connection Parameters (Obtained from RDM Product Tech Docs)
DARWIN_BOOTSTRAP_SERVERS=kafka.rail-data-marketplace.co.uk:9092
DARWIN_TOPIC=darwin.push.trains
DARWIN_CONSUMER_GROUP=swifttrack-consumer-group

# RDM Security Credentials (DO NOT COMMIT REAL PASSWORDS TO GIT)
DARWIN_USERNAME=your_rdm_consumer_username
DARWIN_PASSWORD=your_rotated_rdm_consumer_password
DARWIN_SECURITY_PROTOCOL=SASL_SSL
DARWIN_SASL_MECHANISM=PLAIN
DARWIN_CA_CERTIFICATE_PATH=./certs/rdm_ca.pem
ENABLE_DARWIN_SIMULATOR=false

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=swifttrack-6bc00
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# --- Payment Gateway Credentials ---
# Stripe API Keys (Dashboard -> Developers -> API keys & Webhooks)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# PayPal API Keys (Developer Dashboard -> Apps & Credentials)
PAYPAL_MODE=sandbox # sandbox or live
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Environment Mode (development / production)
NODE_ENV=development
LOG_LEVEL=info
